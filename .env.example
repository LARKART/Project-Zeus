# Copy to .env and fill in. .env is git-ignored; this template is not.
#
# ZEUS reads ANTHROPIC_API_KEY from the environment — this file is not
# auto-loaded. Source it before running:
#
#     set -a; source .env; set +a
#
# `zeus doctor` reports a FAIL when this is unset.

ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
